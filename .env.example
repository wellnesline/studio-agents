# studio-agents/.env として保存。起動時に未設定の環境変数だけを補完します。
# APIキー(必要なエージェントの分だけ設定。行を編集してください)
# gpt-image(Slide AI画像 / Blog図解 / Reslide / Blogcast)
OPENAI_API_KEY=
# 動画の音声(Slidecast / Blogcast)
ELEVENLABS_API_KEY=
# 音声プリセットの既定（slidecast voices で一覧。--voice を省略したときに使う。未設定なら --voice が必須）
DEFAULT_VOICE_PRESET=
# 別途用意する動画バックエンドの配置を上書きする場合のみ設定（空欄なら、studio-agents と同じ階層の video-backend/backend を探します）
VIDEO_BACKEND_DIR=
